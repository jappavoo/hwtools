#!/bin/bash
# Authored with Google Gemini
(( HW_DEBUG )) && set -x

scriptdir=$(dirname $(realpath $0))
configdir=$scriptdir/config

# --- REMOTE WORKSTATION AUTO-DETECTION PHASE ---
# Change this variable to match your Raspberry Pi's private network domain/IP
HEAD_NODE="JA-HW-HEAD"
GRP=dialout
SECONDARY_GROUPS="gpio"

# Detect if we are running locally on the Raspberry Pi 4 
if [ ! -f /proc/device-tree/model ] || ! grep -q "Raspberry Pi" /proc/device-tree/model; then
    # We are running on a user's external workstation. 
    # SSH dynamically uses the active workstation username ($USER) to connect to the Pi.
    COMMAND="$1"
    
    if [ "$COMMAND" == "upload" ]; then
        LOCAL_FILE="$2"
        if [ -z "$LOCAL_FILE" ] || [ ! -f "$LOCAL_FILE" ]; then
            echo "Error: Please specify a valid local file path to upload."; exit 2
        fi
        echo "Transferring asset over private network to Pi staging zone..."
        
        # Connect using SSH host config mappings
        scp "$LOCAL_FILE" "${HEAD_NODE}:/tmp/hw-upload-tmp" && \
        ssh -q -t "${HEAD_NODE}" "hw upload /tmp/hw-upload-tmp $(basename "$LOCAL_FILE")"
        exit $?
    elif [ "$COMMAND" == "cmdline" ] && [ "$2" == "upload" ]; then
        HOST="$3"
        LOCAL_FILE="$4"
        DEST_FILE="$5"
        if [ -z "$HOST" ] || [ -z "$LOCAL_FILE" ] || [ ! -f "$LOCAL_FILE" ]; then
            echo "Error: Usage: hw cmdline upload <host> <local-file> [dest-file]"; exit 2
        fi
        if [ -z "$DEST_FILE" ]; then
            DEST_FILE="$(basename "$LOCAL_FILE")"
        fi
        echo "Transferring cmdline over private network to Pi staging zone..."
        scp "$LOCAL_FILE" "${HEAD_NODE}:/tmp/hw-cmdline-upload-$(basename "$LOCAL_FILE")" && \
        ssh -q -t "${HEAD_NODE}" "hw cmdline upload $HOST /tmp/hw-cmdline-upload-$(basename "$LOCAL_FILE") $DEST_FILE"
        exit $?
    elif [ -z "$COMMAND" ]; then
        # Forward naked list queries cleanly using active user session context
        exec ssh -q -t "${HEAD_NODE}" "hw"
    else
        # Forward shortcuts and power actions preserving the explicit username
        exec ssh -q -t "${HEAD_NODE}" "hw $@"
    fi
    exit 0
fi
# --- END WORKSTATION REDIRECTION PHASE (Execution below only runs on the Pi) ---

# 1. HARDWARE & PATH CONFIGURATION
GPIO_CHIP="gpiochip0"
BASE_TFTP_DIR="/srv/tftp"
LOG_DIR="/var/log/serial"

# ASSOCIATIVE ARRAY CONFIGURATION
declare -A SYSTEM_MAP
SYSTEM_MAP["vic1"]="18:24:ttyVIC1:$BASE_TFTP_DIR/vic1"
SYSTEM_MAP["vic2"]="19:25:ttyVIC2:$BASE_TFTP_DIR/vic2"
declare -A SYSTEM_MAC
SYSTEM_MAC["vic1"]="01-64-00-6a-50-c4-3f"
SYSTEM_MAC["vic2"]="01-64-00-6a-51-43-e0"

PXE_CFG_DIR="$BASE_TFTP_DIR/pxelinux.cfg"
PXE_PROD_DIR="$PXE_CFG_DIR/production"
PXE_USER_DIR="$PXE_CFG_DIR/users/$USER"

# Operational Timeouts (Seconds)
SOFT_OFF_TIMEOUT=30
HARD_OFF_TIMEOUT=10
BOOT_TIMEOUT=15
# 2. INTERNAL ENVIRONMENT HELPERS
USER_STAGING_DIR="$BASE_TFTP_DIR/users/$USER"

ensure_user_staging() {
    local target_user="${1:-$USER}"
    local target_dir="$BASE_TFTP_DIR/users/$target_user"
    if [ ! -d "$target_dir" ]; then
        sudo mkdir -p "$target_dir"
        sudo chown "$target_user:$GRP" "$target_dir"
        sudo chmod 770 "$target_dir"
    fi
}

ensure_pxe_tree() {
    mkdir -p "$PXE_PROD_DIR" "$PXE_CFG_DIR/users/$USER"
}

get_host_mac() {
    local target_host=$1
    if [ -z "${SYSTEM_MAC[$target_host]}" ]; then
        return 1
    fi
    printf '%s\n' "${SYSTEM_MAC[$target_host]}"
}

list_pxe_files() {
    local source_name=$1
    local target_host=$2
    local target_dir
    local -a files=()
    local path

    case "$source_name" in
        production)
            target_dir="$PXE_PROD_DIR/$target_host"
            ;;
        staging)
            target_dir="$PXE_CFG_DIR/users/$USER/$target_host"
            ;;
        *)
            return 1
            ;;
    esac
    shopt -s nullglob
    files=( "$target_dir"/* )
    shopt -u nullglob

    if [ "$source_name" = "staging" ]; then
        echo "STAGED CMDLINE FILES FOR: $target_host"
    else
        echo "PRODUCTION CMDLINE FILES FOR: $target_host"
    fi
    echo "-------------------------------------------------------------"
    printf "%-40s %-17s %-10s %s\n" "FILE" "DATE" "SIZE" "MD5SUM"
    if [ ${#files[@]} -eq 0 ]; then
        echo "No cmdline files found."
        return 0
    fi
    for path in "${files[@]}"; do
        [ -f "$path" ] || continue
        print_file_metadata "$path"
    done
}

resolve_pxe_candidate() {
    local source_name=$1
    local target_host=$2
    local requested_file=$3
    local target_dir
    local -a candidates=()
    local path
    local count=0

    case "$source_name" in
        production)
            target_dir="$PXE_PROD_DIR/$target_host"
            ;;
        staging)
            target_dir="$PXE_CFG_DIR/users/$USER/$target_host"
            ;;
        *)
            return 1
            ;;
    esac
    shopt -s nullglob
    candidates=( "$target_dir"/* )
    shopt -u nullglob

    if [ -n "$requested_file" ]; then
        path="$target_dir/$requested_file"
        if [ ! -f "$path" ]; then
            echo "Error: Cmdline file '$requested_file' not found for '$target_host' ($source_name)."
            exit 2
        fi
        printf '%s\n' "$path"
        return 0
    fi

    for path in "${candidates[@]}"; do
        [ -f "$path" ] || continue
        count=$((count + 1))
    done

    if [ "$count" -eq 1 ]; then
        for path in "${candidates[@]}"; do
            [ -f "$path" ] || continue
            printf '%s\n' "$path"
            return 0
        done
    fi

    if [ "$count" -gt 1 ]; then
        list_pxe_files "$source_name" "$target_host"
        echo "Error: Multiple cmdline files exist for '$target_host' ($source_name). Rerun with explicit filename."
        exit 2
    fi

    echo "Error: No cmdline files are available for '$target_host' ($source_name)."
    exit 2
}

get_active_pxe_target() {
    local target_host=$1
    local mac
    mac=$(get_host_mac "$target_host") || return 1
    readlink -f "$PXE_CFG_DIR/$mac" 2>/dev/null || printf '%s\n' "$PXE_CFG_DIR/$mac"
}

set_active_pxe_target() {
    local target_host=$1
    local source_name=$2
    local requested_file=$3
    local mac
    local target_path

    ensure_pxe_tree
    mac=$(get_host_mac "$target_host") || {
        echo "Error: Specify a valid target system: ${!SYSTEM_MAP[@]}"
        exit 2
    }
    target_path=$(resolve_pxe_candidate "$source_name" "$target_host" "$requested_file")
    ln -sf "$target_path" "$PXE_CFG_DIR/$mac"
    echo "SUCCESS: Activated ${source_name} cmdline for '$target_host'."
}

list_host_production_files() {
    local target_host=$1
    local target_dir="$BASE_TFTP_DIR/$target_host/production"
    local -a production_files=()
    local path

    shopt -s nullglob
    production_files=( "$target_dir"/* )
    shopt -u nullglob

    echo "PRODUCTION FILES FOR: $target_host"
    echo "-------------------------------------------------------------"
    printf "%-40s %-17s %-10s %s\n" "FILE" "DATE" "SIZE" "MD5SUM"
    if [ ${#production_files[@]} -eq 0 ]; then
        echo "No production files found."
        return 0
    fi

    for path in "${production_files[@]}"; do
        [ -e "$path" ] || continue
        print_file_metadata "$path"
    done
}

print_file_metadata() {
    local file_path=$1
    local file_name
    local file_date
    local file_size
    local file_md5

    file_name="${file_path##*/}"
    file_date=$(date -d "$(stat -c '%y' "$file_path" 2>/dev/null)" '+%y/%m/%d %H:%M:%S' 2>/dev/null)
    file_size=$(stat -c '%s' "$file_path" 2>/dev/null)
    file_md5=$(md5sum "$file_path" 2>/dev/null)
    file_md5=${file_md5%% *}

    if [ -z "$file_date" ] || [ -z "$file_size" ] || [ -z "$file_md5" ]; then
        return 1
    fi

    printf "%-40s %-17s %-10s %s\n" "$file_name" "$file_date" "$file_size" "$file_md5"
}

list_production_candidates() {
    local target_dir=$1
    local kind=$2
    local -a candidates=()
    local path
    local name

    shopt -s nullglob
    case "$kind" in
        kernel)
            candidates=( "$target_dir"/production/*vmlinuz* "$target_dir"/production/*zImage* )
            ;;
        initrd)
            candidates=( "$target_dir"/production/*initrd* "$target_dir"/production/*ramdisk* )
            ;;
    esac
    shopt -u nullglob

    echo "Available production ${kind}s for $(basename "$target_dir"):"
    for path in "${candidates[@]}"; do
        [ -f "$path" ] || continue
        name=${path##*/}
        echo "  $name"
    done
}

resolve_production_image() {
    local target_dir=$1
    local kind=$2
    local requested=$3
    local -a candidates=()
    local path
    local name
    local matched=0

    shopt -s nullglob
    case "$kind" in
        kernel)
            candidates=( "$target_dir"/production/*vmlinuz* "$target_dir"/production/*zImage* )
            ;;
        initrd)
            candidates=( "$target_dir"/production/*initrd* "$target_dir"/production/*ramdisk* )
            ;;
    esac
    shopt -u nullglob

    if [ -n "$requested" ]; then
        path="$target_dir/production/$requested"
        if [ ! -f "$path" ]; then
            echo "Error: Production $kind '$requested' not found for $(basename "$target_dir")."
            exit 2
        fi
        case "$kind" in
            kernel)
                if [[ "$requested" != *vmlinuz* && "$requested" != *zImage* ]]; then
                    echo "Error: '$requested' is not a production kernel image."; exit 2
                fi
                ;;
            initrd)
                if [[ "$requested" != *initrd* && "$requested" != *ramdisk* ]]; then
                    echo "Error: '$requested' is not a production initrd image."; exit 2
                fi
                ;;
        esac
        printf '%s\n' "$path"
        return 0
    fi

    for path in "${candidates[@]}"; do
        [ -f "$path" ] || continue
        matched=$((matched + 1))
    done

    if [ "$matched" -eq 1 ]; then
        for path in "${candidates[@]}"; do
            [ -f "$path" ] || continue
            printf '%s\n' "$path"
            return 0
        done
    fi

    if [ "$matched" -gt 1 ]; then
        list_production_candidates "$target_dir" "$kind"
        echo "Error: Multiple production ${kind}s exist for $(basename "$target_dir"). Rerun with explicit filenames."
        exit 2
    fi

    echo "Error: No production $kind images are available for $(basename "$target_dir")."
    exit 2
}

check_status() {
    local line_in=$1
    local current_state
    if ! current_state=$(gpioget --numeric --bias pull-up --chip "$GPIO_CHIP" "$line_in" 2>/dev/null); then
        if ! current_state=$(gpioget --numeric --bias pull-up "$line_in" 2>/dev/null); then
            echo "UNKNOWN"
            return 1
        fi
    fi

    if [[ "$current_state" =~ ^[01]$ ]]; then
        if [ "$current_state" -eq 0 ]; then
            echo "ON"
        else
            echo "OFF"
        fi
    else
        echo "UNKNOWN"
        return 1
    fi
}

pulse_power_line() {
    local line_out=$1
    local hold_seconds=$2

    if ! gpioset -c "$GPIO_CHIP" "$line_out=1" 2>/dev/null; then
        if ! gpioset "$GPIO_CHIP" "$line_out=1" 2>/dev/null; then
            return 1
        fi
    fi

    sleep "$hold_seconds"

    if ! gpioset -c "$GPIO_CHIP" "$line_out=0" 2>/dev/null; then
        if ! gpioset "$GPIO_CHIP" "$line_out=0" 2>/dev/null; then
            return 1
        fi
    fi
}

wait_for_state() {
    local line_in=$1
    local target_state=$2
    local timeout=$3
    local elapsed=0
    while [ $elapsed -lt $timeout ]; do
        sleep 1
        elapsed=$((elapsed + 1))
        local current=$(check_status $line_in)
        if [ "$current" == "$target_state" ]; then return 0; fi
    done
    return 1
}

get_console_lock_pid() {
    local serial_dev=$1
    local device="/dev/$serial_dev"
    local resolved_device
    local line
    local pid
    local locked_path

    resolved_device=$(readlink -f "$device" 2>/dev/null || printf '%s' "$device")

    while IFS= read -r line; do
        [ -z "$line" ] && continue
        set -- $line
        pid=$1
        locked_path=$2
        if [ "$locked_path" = "$device" ] || [ "$locked_path" = "$resolved_device" ]; then
            printf '%s\n' "$pid"
            return 0
        fi
    done < <(lslocks --notruncate --noheadings -o PID,PATH 2>/dev/null)

    return 1
}

get_console_lock_owner() {
    local lock_pid=$1
    local lock_owner

    lock_owner=$(ps -o user= -p "$lock_pid" 2>/dev/null)
    lock_owner=${lock_owner//[[:space:]]/}
    printf '%s\n' "$lock_owner"
}

format_log_age() {
    local file_mtime=$1
    local now_epoch
    local age_seconds
    local days hours minutes
    local parts=()

    now_epoch=$(date +%s)
    age_seconds=$((now_epoch - file_mtime))

    if [ "$age_seconds" -lt 60 ]; then
        printf '%ss\n' "$age_seconds"
        return 0
    fi

    minutes=$((age_seconds / 60))
    if [ "$minutes" -lt 60 ]; then
        printf '%sm\n' "$minutes"
        return 0
    fi

    hours=$((minutes / 60))
    minutes=$((minutes % 60))
    if [ "$hours" -lt 24 ]; then
        if [ "$minutes" -gt 0 ]; then
            printf '%sh%sm\n' "$hours" "$minutes"
        else
            printf '%sh\n' "$hours"
        fi
        return 0
    fi

    days=$((hours / 24))
    hours=$((hours % 24))
    if [ "$hours" -gt 0 ]; then
        printf '%sd%sh\n' "$days" "$hours"
    else
        printf '%sd\n' "$days"
    fi
}

print_console_lock_status() {
    local serial_dev=$1
    local lock_pid
    local lock_owner

    lock_pid=$(get_console_lock_pid "$serial_dev")
    if [ -z "$lock_pid" ]; then
        echo "LOCK STATUS: [FREE]"
        return 0
    fi

    lock_owner=$(get_console_lock_owner "$lock_pid")
    if [ -z "$lock_owner" ]; then
        echo "LOCK STATUS: [LOCKED] (pid $lock_pid)"
    else
        echo "LOCK STATUS: held by $lock_owner (pid $lock_pid)"
    fi
}

check_console_lock() {
    local serial_dev=$1
    local active_user="${SUDO_USER:-$USER}"
    local lock_pid
    lock_pid=$(get_console_lock_pid "$serial_dev")

    if [ -z "$lock_pid" ]; then
        echo "SECURITY ERROR: Control denied. You must open a console first."
        echo "Run: hw $SYS_NAME"
        exit 3
    fi

    local lock_owner
    lock_owner=$(get_console_lock_owner "$lock_pid")
    if [ -z "$lock_owner" ]; then
        echo "SECURITY ERROR: Console lock could not be resolved."
        exit 3
    fi
    if [ "$lock_owner" != "$active_user" ]; then
        echo "SECURITY ERROR: Control denied. Active lock is held by user '$lock_owner'."
        exit 3
    fi
}

# 3. COMMAND INTERCEPTOR & ENGINE ROUTER
COMMAND="$1"

# --- SHORTCUT GATING PHASE ---
if [[ -v SYSTEM_MAP[$COMMAND] ]]; then
    if [ -z "$2" ]; then
        SYS_NAME="$COMMAND"
        COMMAND="con"
    else
        SYS_NAME="$COMMAND"
        COMMAND="$2"
    fi
fi
# ------------------------------

if [ -z "$COMMAND" ]; then
    echo "============================================================="
    echo "AVAILABLE TARGET SYSTEMS"
    echo "============================================================="
    printf "%-12s %-8s %-12s %-12s\n" "HOST" "STATUS" "SERIAL PORT" "LOCK HOLDER"
    echo "-------------------------------------------------------------"
    for host in "${!SYSTEM_MAP[@]}"; do
        CONFIG="${SYSTEM_MAP[$host]}"
        L_IN=$(echo "$CONFIG" | cut -d':' -f2)
        S_DEV=$(echo "$CONFIG" | cut -d':' -f3)
        
        CUR_STAT=$(check_status $L_IN)
        HOLDER="[FREE]"

        LPID=$(get_console_lock_pid "$S_DEV")
        if [ -n "$LPID" ]; then
            HOLDER=$(get_console_lock_owner "$LPID")
            if [ -z "$HOLDER" ]; then
                HOLDER="[LOCKED]"
            fi
        fi
        printf "%-12s %-8s %-12s %-12s\n" "$host" "$CUR_STAT" "/dev/$S_DEV" "$HOLDER"
    done
    exit 0
fi
case "$COMMAND" in
    con)
        if [ -z "$SYS_NAME" ]; then SYS_NAME="$2"; fi
        if [ -z "$SYS_NAME" ] || [[ ! -v SYSTEM_MAP[$SYS_NAME] ]]; then
            echo "Error: Specify a valid target system: ${!SYSTEM_MAP[@]}"; exit 2
        fi
        SERIAL_DEV=$(echo "${SYSTEM_MAP[$SYS_NAME]}" | cut -d':' -f3)
        TIMESTAMP=$(date +%Y-%m-%d_%H-%M-%S)
        LOG_FILE="$LOG_DIR/${SYS_NAME}con.${TIMESTAMP}.log"
        
        echo "Connecting to $SYS_NAME console (/dev/$SERIAL_DEV via picocom)..."
        echo "Logging session output to: $LOG_FILE"
        sleep 1
        picocom -b 115200 -f h -g "$LOG_FILE" /dev/"$SERIAL_DEV"
        PICOCOM_STATUS=$?
        if [ "$PICOCOM_STATUS" -ne 0 ]; then
            echo "ERROR: picocom exited with status $PICOCOM_STATUS."
            print_console_lock_status "$SERIAL_DEV"
        fi
        exit "$PICOCOM_STATUS"
        ;;

    log)
        SUB_CMD="$2"
        SYS_NAME="$3"
        LOG_ARG="$4"
        
        if [ -z "$SUB_CMD" ]; then
            SUB_CMD="ls"
            SYS_NAME="$2"
            LOG_ARG="$3"
        elif [[ "$SUB_CMD" != "ls" && "$SUB_CMD" != "cat" && "$SUB_CMD" != "clean" ]]; then
            if [[ "$SUB_CMD" == *"con."*".log" && "$SUB_CMD" != *"/"* ]]; then
                LOG_ARG="$SUB_CMD"
                SYS_NAME="${SUB_CMD%%con.*.log}"
                SUB_CMD="cat"
            else
                SYS_NAME="$SUB_CMD"
                SUB_CMD="ls"
                LOG_ARG="$3"
            fi
        fi
        if [ "$SUB_CMD" != "clean" ] && { [ -z "$SYS_NAME" ] || [[ ! -v SYSTEM_MAP[$SYS_NAME] ]]; }; then
            echo "Error: Specify a valid target system: ${!SYSTEM_MAP[@]}"; exit 2
        fi
        
        case "$SUB_CMD" in
            ls)
                echo "============================================================="
                echo "AVAILABLE CONSOLE LOGS FOR HOST: $SYS_NAME"
                echo "LOG DIRECTORY: $LOG_DIR"
                echo "============================================================="
                shopt -s nullglob
                LOG_FILES=( "$LOG_DIR"/${SYS_NAME}con.*.log )
                shopt -u nullglob
                if [ ${#LOG_FILES[@]} -eq 0 ]; then
                    echo "No log files found for $SYS_NAME."; exit 0
                fi
                printf "%-40s %-10s %-8s\n" "LOG FILE" "AGE" "SIZE"
                for log_path in "${LOG_FILES[@]}"; do
                    log_name="${log_path##*/}"
                    log_size=$(stat -c '%s' "$log_path" 2>/dev/null)
                    log_mtime=$(stat -c '%Y' "$log_path" 2>/dev/null)
                    if [ -z "$log_size" ] || [ -z "$log_mtime" ]; then
                        continue
                    fi
                    log_age=$(format_log_age "$log_mtime")
                    printf "%-40s %-10s %-8s\n" "$log_name" "$log_age" "$log_size"
                done
                ;;
            cat)
                if [ -z "$LOG_ARG" ]; then
                    shopt -s nullglob
                    LOG_FILES=( "$LOG_DIR"/${SYS_NAME}con.*.log )
                    shopt -u nullglob
                    if [ ${#LOG_FILES[@]} -eq 0 ]; then echo "Error: No logs exist for $SYS_NAME."; exit 1; fi
                    LATEST_LOG="${LOG_FILES[$((${#LOG_FILES[@]} - 1))]}"
                    cat "$LATEST_LOG"
                else
                    if [[ "$LOG_ARG" == *"/"* ]] || [[ "$LOG_ARG" != ${SYS_NAME}con.*.log ]]; then
                        echo "Error: Invalid log file path mapping."; exit 2
                    fi
                    FULL_LOG_PATH="$LOG_DIR/$LOG_ARG"
                    if [ ! -f "$FULL_LOG_PATH" ]; then
                        echo "Error: Invalid log file path mapping."; exit 2
                    fi
                    cat "$FULL_LOG_PATH"
                fi
                ;;
            clean)
                    CLEAN_ARGS=("${@:3}")
                    if [ ${#CLEAN_ARGS[@]} -eq 0 ]; then
                        echo "Error: Specify a log basename, a list of basenames, or re:<regex>."; exit 2
                    fi

                    MATCHES=()
                    shopt -s nullglob
                    LOG_FILES=( "$LOG_DIR"/*.log )
                    shopt -u nullglob

                    if [ ${#CLEAN_ARGS[@]} -eq 1 ]; then
                        CLEAN_SPEC="${CLEAN_ARGS[0]}"
                        if [[ "$CLEAN_SPEC" == re:* ]]; then
                            CLEAN_REGEX="${CLEAN_SPEC#re:}"
                            for log_path in "${LOG_FILES[@]}"; do
                                log_name="${log_path##*/}"
                                if [[ "$log_name" =~ $CLEAN_REGEX ]]; then
                                    MATCHES+=( "$log_name" )
                                fi
                            done
                        elif [[ "$CLEAN_SPEC" == *[\*\?\[]* ]]; then
                            for log_path in "${LOG_FILES[@]}"; do
                                log_name="${log_path##*/}"
                                if [[ "$log_name" == $CLEAN_SPEC ]]; then
                                    MATCHES+=( "$log_name" )
                                fi
                            done
                        else
                            if [[ "$CLEAN_SPEC" == *"/"* ]] || [[ "$CLEAN_SPEC" != *.log ]] || [[ "$CLEAN_SPEC" != *con.*.log ]]; then
                                echo "Error: Invalid log file basename."; exit 2
                            fi
                            MATCHES+=( "$CLEAN_SPEC" )
                        fi
                    else
                        for CLEAN_LOG in "${CLEAN_ARGS[@]}"; do
                            if [[ "$CLEAN_LOG" == *"/"* ]] || [[ "$CLEAN_LOG" != *.log ]] || [[ "$CLEAN_LOG" != *con.*.log ]]; then
                                echo "Error: Invalid log file basename: $CLEAN_LOG"; exit 2
                            fi
                            MATCHES+=( "$CLEAN_LOG" )
                        done
                    fi

                    if [ ${#MATCHES[@]} -eq 0 ]; then
                        echo "No log files matched."
                        exit 0
                    fi

                    echo "The following log files will be removed:"
                    for log_name in "${MATCHES[@]}"; do
                        echo "  $log_name"
                    done
                    read -r -p "Proceed? [y/N] " CONFIRM
                    if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
                        echo "Aborted."
                        exit 0
                    fi
                    for log_name in "${MATCHES[@]}"; do
                        rm -f "$LOG_DIR/$log_name"
                    done
                    echo "SUCCESS: Removed ${#MATCHES[@]} log file(s)."
                    ;;
        esac
        ;;
    upload)
        FILE_PATH="$2"
        ALT_NAME="$3" # Passed internally from workstation mode to preserve original filename
        if [ -z "$FILE_PATH" ] || [ ! -f "$FILE_PATH" ]; then
            echo "Error: Please specify a valid local file to upload."; exit 2
        fi
        ensure_user_staging
        
        if [ -n "$ALT_NAME" ]; then FILENAME="$ALT_NAME"; else FILENAME=$(basename "$FILE_PATH"); fi
        TARGET_DEST="$USER_STAGING_DIR/$FILENAME"
        
        mv "$FILE_PATH" "$TARGET_DEST" 2>/dev/null || cp "$FILE_PATH" "$TARGET_DEST"
        echo "Uploaded and staged: $FILENAME"
        
        if [ ! -L "$USER_STAGING_DIR/vmlinuz" ] && [[ "$FILENAME" == *"vmlinuz"* || "$FILENAME" == *"zImage"* ]]; then
            ln -sf "$TARGET_DEST" "$USER_STAGING_DIR/vmlinuz"
        fi
        if [ ! -L "$USER_STAGING_DIR/initrd.img" ] && [[ "$FILENAME" == *"initrd"* || "$FILENAME" == *"ramdisk"* ]]; then
            ln -sf "$TARGET_DEST" "$USER_STAGING_DIR/initrd.img"
        fi
        ;;

    ls)
        LS_MODE="${2:-stage}"
        LS_HOST="$3"
        if [ "$LS_MODE" != "stage" ] && [ "$LS_MODE" != "prod" ]; then
            echo "Error: Usage: hw ls [stage|prod]"; exit 2
        fi
        if [ "$LS_MODE" = "prod" ]; then
            echo "============================================================="
            echo "PRODUCTION BOOT FILES"
            echo "============================================================="
            if [ -n "$LS_HOST" ]; then
                if [[ ! -v SYSTEM_MAP[$LS_HOST] ]]; then
                    echo "Error: Specify a valid target system: ${!SYSTEM_MAP[@]}"; exit 2
                fi
                list_host_production_files "$LS_HOST"
            else
                for host in "${!SYSTEM_MAP[@]}"; do
                    list_host_production_files "$host"
                done
            fi
            exit 0
        fi
        ensure_user_staging
        echo "============================================================="
        echo "STAGED USER FILES FOR: $USER"
        echo "-------------------------------------------------------------"
        if [ -z "$(ls -A "$USER_STAGING_DIR")" ]; then echo "Staging is empty."; exit 0; fi
        printf "%-40s %-17s %-10s %s\n" "FILE" "DATE" "SIZE" "MD5SUM"
        for path in "$USER_STAGING_DIR"/*; do
            [ -f "$path" ] || continue
            print_file_metadata "$path"
        done
        ;;

    activate)
        TARGET_MODE="$2"
        TARGET_ARG="$3"
        TARGET_KERNEL="$4"
        TARGET_INITRD="$5"
        ensure_user_staging
        if [ -z "$TARGET_MODE" ]; then
            echo "Error: Target file not found."; exit 2
        fi
        if [[ "$TARGET_MODE" == "production" || "$TARGET_MODE" == "staging" ]]; then
            if [ -z "$TARGET_ARG" ] || [[ ! -v SYSTEM_MAP[$TARGET_ARG] ]]; then
                echo "Error: Specify a valid target system: ${!SYSTEM_MAP[@]}"; exit 2
            fi
            PIN_CONFIG="${SYSTEM_MAP[$TARGET_ARG]}"
            TFTP_PATH=$(echo "$PIN_CONFIG" | cut -d':' -f4)
            case "$TARGET_MODE" in
                production)
                    PROD_KERNEL=$(resolve_production_image "$TFTP_PATH" kernel "$TARGET_KERNEL")
                    PROD_INITRD=$(resolve_production_image "$TFTP_PATH" initrd "$TARGET_INITRD")
                    ln -sf "$PROD_KERNEL" "$TFTP_PATH/vmlinuz"
                    ln -sf "$PROD_INITRD" "$TFTP_PATH/initrd.img"
                    echo "SUCCESS: Activated production boot images for '$TARGET_ARG'."
                    ;;
                staging)
                    if [ -n "$TARGET_KERNEL" ] || [ -n "$TARGET_INITRD" ]; then
                        if [ -z "$TARGET_KERNEL" ] || [ -z "$TARGET_INITRD" ]; then
                            echo "Error: Specify both kernel and initrd staged filenames."; exit 2
                        fi
                        if [ ! -f "$USER_STAGING_DIR/$TARGET_KERNEL" ] || [ ! -f "$USER_STAGING_DIR/$TARGET_INITRD" ]; then
                            echo "ERROR: Staged kernel or initrd file not found."; exit 2
                        fi
                        ln -sf "$USER_STAGING_DIR/$TARGET_KERNEL" "$TFTP_PATH/vmlinuz"
                        ln -sf "$USER_STAGING_DIR/$TARGET_INITRD" "$TFTP_PATH/initrd.img"
                        echo "SUCCESS: Activated staged boot images for '$TARGET_ARG' using '$TARGET_KERNEL' and '$TARGET_INITRD'."
                    elif [ ! -L "$USER_STAGING_DIR/vmlinuz" ] || [ ! -L "$USER_STAGING_DIR/initrd.img" ]; then
                        echo "ERROR: Missing active staging files."; exit 2
                    else
                        ln -sf "$USER_STAGING_DIR/vmlinuz" "$TFTP_PATH/vmlinuz"
                        ln -sf "$USER_STAGING_DIR/initrd.img" "$TFTP_PATH/initrd.img"
                        echo "SUCCESS: Activated staging boot images for '$TARGET_ARG'."
                    fi
                    ;;
            esac
        elif [ ! -f "$USER_STAGING_DIR/$TARGET_MODE" ]; then
            echo "Error: Target file not found."; exit 2
        elif [[ "$TARGET_MODE" == *"vmlinuz"* || "$TARGET_MODE" == *"zImage"* ]]; then
            ln -sf "$USER_STAGING_DIR/$TARGET_MODE" "$USER_STAGING_DIR/vmlinuz"
            echo "SUCCESS: Staging kernel link updated."
        elif [[ "$TARGET_MODE" == *"initrd"* || "$TARGET_MODE" == *"ramdisk"* ]]; then
            ln -sf "$USER_STAGING_DIR/$TARGET_MODE" "$USER_STAGING_DIR/initrd.img"
            echo "SUCCESS: Staging initrd link updated."
        else
            echo "Error: File type ambiguous."; exit 2
        fi
        ;;

    cmdline)
        CMD_ACTION="${2:-ls}"
        ensure_pxe_tree
        case "$CMD_ACTION" in
            ls)
                CMD_SOURCE="${3:-stage}"
                CMD_HOST="$4"
                if [ "$CMD_SOURCE" != "stage" ] && [ "$CMD_SOURCE" != "prod" ]; then
                    echo "Error: Usage: hw cmdline ls [stage|prod [host]]"; exit 2
                fi
                if [ "$CMD_SOURCE" = "prod" ]; then
                    echo "============================================================="
                    echo "PRODUCTION CMDLINE FILES"
                    echo "============================================================="
                    if [ -n "$CMD_HOST" ]; then
                        if [[ ! -v SYSTEM_MAC[$CMD_HOST] ]]; then
                            echo "Error: Specify a valid target system: ${!SYSTEM_MAP[@]}"; exit 2
                        fi
                        list_pxe_files production "$CMD_HOST"
                    else
                        for host in "${!SYSTEM_MAP[@]}"; do
                            list_pxe_files production "$host"
                        done
                    fi
                else
                    echo "============================================================="
                    echo "STAGED CMDLINE FILES"
                    echo "============================================================="
                    if [ -n "$CMD_HOST" ]; then
                        if [[ ! -v SYSTEM_MAC[$CMD_HOST] ]]; then
                            echo "Error: Specify a valid target system: ${!SYSTEM_MAP[@]}"; exit 2
                        fi
                        list_pxe_files staging "$CMD_HOST"
                    else
                        for host in "${!SYSTEM_MAP[@]}"; do
                            list_pxe_files staging "$host"
                        done
                    fi
                fi
                ;;
            cat)
                CMD_SOURCE="${3:-active}"
                CMD_HOST="$4"
                CMD_FILE="$5"
                if [ -z "$CMD_HOST" ]; then
                    CMD_HOST="$CMD_SOURCE"
                    CMD_SOURCE="active"
                    CMD_FILE="$4"
                fi
                if [ -z "$CMD_HOST" ] || [[ ! -v SYSTEM_MAC[$CMD_HOST] ]]; then
                    echo "Error: Specify a valid target system: ${!SYSTEM_MAP[@]}"; exit 2
                fi
                case "$CMD_SOURCE" in
                    active)
                        ACTIVE_PATH=$(get_active_pxe_target "$CMD_HOST")
                        if [ ! -f "$ACTIVE_PATH" ]; then
                            echo "Error: No active cmdline exists for '$CMD_HOST'."; exit 2
                        fi
                        cat "$ACTIVE_PATH"
                        ;;
                    prod|production)
                        PROD_PATH=$(resolve_pxe_candidate production "$CMD_HOST" "$CMD_FILE")
                        cat "$PROD_PATH"
                        ;;
                    stage|staging)
                        STAGE_PATH=$(resolve_pxe_candidate staging "$CMD_HOST" "$CMD_FILE")
                        cat "$STAGE_PATH"
                        ;;
                    *)
                        echo "Error: Usage: hw cmdline cat [active|prod|stage] <host> [file]"; exit 2
                        ;;
                esac
                ;;
            seed)
                CMD_HOST="$3"
                CMD_SOURCE_FILE="$4"
                CMD_DEST_FILE="$5"
                if [ -z "$CMD_HOST" ] || [[ ! -v SYSTEM_MAC[$CMD_HOST] ]]; then
                    echo "Error: Specify a valid target system: ${!SYSTEM_MAP[@]}"; exit 2
                fi
                PROD_PATH=$(resolve_pxe_candidate production "$CMD_HOST" "$CMD_SOURCE_FILE")
                mkdir -p "$PXE_CFG_DIR/users/$USER/$CMD_HOST"
                if [ -z "$CMD_DEST_FILE" ]; then
                    CMD_DEST_FILE="${PROD_PATH##*/}"
                fi
                cp "$PROD_PATH" "$PXE_CFG_DIR/users/$USER/$CMD_HOST/$CMD_DEST_FILE"
                echo "SUCCESS: Seeded staged cmdline '$CMD_DEST_FILE' for '$CMD_HOST'."
                ;;
            upload)
                CMD_HOST="$3"
                CMD_SOURCE_FILE="$4"
                CMD_DEST_FILE="$5"
                if [ -z "$CMD_HOST" ] || [[ ! -v SYSTEM_MAC[$CMD_HOST] ]]; then
                    echo "Error: Usage: hw cmdline upload <host> <local-file> [dest-file]"; exit 2
                fi
                if [ -z "$CMD_SOURCE_FILE" ] || [ ! -f "$CMD_SOURCE_FILE" ]; then
                    echo "Error: Usage: hw cmdline upload <host> <local-file> [dest-file]"; exit 2
                fi
                ensure_user_staging
                mkdir -p "$PXE_CFG_DIR/users/$USER/$CMD_HOST"
                if [ -z "$CMD_DEST_FILE" ]; then
                    CMD_DEST_FILE="${CMD_SOURCE_FILE##*/}"
                fi
                if [[ "$CMD_DEST_FILE" == *"/"* ]]; then
                    echo "Error: Destination filename must not include a path."; exit 2
                fi
                cp "$CMD_SOURCE_FILE" "$PXE_CFG_DIR/users/$USER/$CMD_HOST/$CMD_DEST_FILE"
                echo "SUCCESS: Uploaded staged cmdline '$CMD_DEST_FILE' for '$CMD_HOST'."
                ;;
            activate)
                CMD_SOURCE="$3"
                CMD_HOST="$4"
                CMD_FILE="$5"
                if [ -z "$CMD_SOURCE" ] || [ -z "$CMD_HOST" ]; then
                    echo "Error: Usage: hw cmdline activate {production|staging} <host> [file]"; exit 2
                fi
                if [[ ! -v SYSTEM_MAC[$CMD_HOST] ]]; then
                    echo "Error: Specify a valid target system: ${!SYSTEM_MAP[@]}"; exit 2
                fi
                case "$CMD_SOURCE" in
                    production)
                        set_active_pxe_target "$CMD_HOST" production "$CMD_FILE"
                        ;;
                    staging)
                        set_active_pxe_target "$CMD_HOST" staging "$CMD_FILE"
                        ;;
                    *)
                        echo "Error: Usage: hw cmdline activate {production|staging} <host> [file]"; exit 2
                        ;;
                esac
                ;;
            *)
                echo "Error: Usage: hw cmdline {ls|cat|seed|upload|activate} ..."; exit 2
                ;;
        esac
        ;;

    user)
        USER_CMD="$2"
        TARGET_USER="$3"
        if [ -z "$USER_CMD" ]; then
            echo "============================================================="
            echo "LABORATORY ACCESS USERS ($GRP MEMBER REGISTRY)"
            echo "============================================================="
            getent group $GRP | cut -d':' -f4 | tr ',' '\n'; exit 0
        fi
        if [[ "$USER_CMD" != "add" && "$USER_CMD" != "del" ]] || [ -z "$TARGET_USER" ]; then
            echo "Error: Invalid user syntax."; echo "Usage: hw user {add|del} <username>"; exit 2
        fi
        if [ "$EUID" -ne 0 ]; then
            echo "Administrative access required. Re-routing via sudo..."
            exec sudo "$0" "$@"
        fi
        if [ "$USER_CMD" == "add" ]; then
            if id "$TARGET_USER" &>/dev/null; then 
                echo "Error: User '$TARGET_USER' already exists on system layers."
                exit 1
            fi

            # 1. Create the base Linux user profile
            useradd -m -s /bin/bash "$TARGET_USER"
            
            # 2. Lock the password field immediately to disable standard password logins
            passwd -l "$TARGET_USER" &>/dev/null
            
            # 3. Add user to the core lab peripheral access group.
            LAB_GROUPS="$GRP"
            for extra_group in ${SECONDARY_GROUPS//,/ }; do
                if [ "$extra_group" != "$GRP" ] && getent group "$extra_group" >/dev/null 2>&1; then
                    LAB_GROUPS="$LAB_GROUPS,$extra_group"
                fi
            done
            usermod -aG "$LAB_GROUPS" "$TARGET_USER"
            ensure_user_staging "$TARGET_USER"
            
            # 4. Generate the secure Ed25519 SSH Keypair inside a temporary location
            TMP_KEY_DIR=$(mktemp -d)
            ssh-keygen -t ed25519 -f "$TMP_KEY_DIR/id_ed25519" -N "" -q -C "$TARGET_USER@$(hostname)"
            
            # 5. Provision the user's local .ssh boundary structures inside their home directory
            USER_HOME=$(eval echo "~$TARGET_USER")
            mkdir -p "$USER_HOME/.ssh"
            cat "$TMP_KEY_DIR/id_ed25519" > "$USER_HOME/.ssh/id_ed25519"
            cat "$TMP_KEY_DIR/id_ed25519.pub" > "$USER_HOME/.ssh/id_ed25519.pub"
            cat "$TMP_KEY_DIR/id_ed25519.pub" > "$USER_HOME/.ssh/authorized_keys"
            
            # Enforce strict standard OpenSSH permissions
            chown -R "$TARGET_USER:$TARGET_USER" "$USER_HOME/.ssh"
            chmod 700 "$USER_HOME/.ssh"
            chmod 600 "$USER_HOME/.ssh/id_ed25519"
            chmod 644 "$USER_HOME/.ssh/id_ed25519.pub"
            chmod 600 "$USER_HOME/.ssh/authorized_keys"
            
            # 6. Output execution results and provide the secure credential block
            echo "SUCCESS: Account profile created for '$TARGET_USER'."
            echo "SUCCESS: Password login has been disabled and locked."
            echo "SUCCESS: Staging workspace directories established."
            echo ""
            echo "========================================================================"
            echo " PRIVATE CREDENTIAL DELIVERY BLOCK FOR USER: $TARGET_USER"
            echo "========================================================================"
            echo "Copy the text block below and save it as an identity file on the new"
            echo "user's development workstation (e.g., ~/.ssh/id_lab_key):"
            echo "------------------------------------------------------------------------"
            cat "$TMP_KEY_DIR/id_ed25519"
            echo "------------------------------------------------------------------------"
            echo "========================================================================"
            
            # Wipe memory traces securely from temp storage
            rm -rf "$TMP_KEY_DIR"
            
        elif [ "$USER_CMD" == "del" ]; then
            if ! id "$TARGET_USER" &>/dev/null; then echo "Error: User does not exist."; exit 1; fi
            userdel -r "$TARGET_USER" 2>/dev/null
            rm -rf "$BASE_TFTP_DIR/users/$TARGET_USER"
            echo "SUCCESS: Purged user account and staging folders for '$TARGET_USER'."
        fi
        ;;

    status|on|off|force-off)
        if [ -z "$SYS_NAME" ]; then SYS_NAME="$2"; fi
        if [ -z "$SYS_NAME" ] || [[ ! -v SYSTEM_MAP[$SYS_NAME] ]]; then
            echo "Error: Invalid host targets."; exit 2
        fi
        
        PIN_CONFIG="${SYSTEM_MAP[$SYS_NAME]}"
        LINE_OUT=$(echo "$PIN_CONFIG" | cut -d':' -f1)
        LINE_IN=$(echo "$PIN_CONFIG" | cut -d':' -f2)
        SERIAL_DEV=$(echo "$PIN_CONFIG" | cut -d':' -f3)
        TFTP_PATH=$(echo "$PIN_CONFIG" | cut -d':' -f4)

        if [ "$COMMAND" == "status" ]; then
            STATUS=$(check_status $LINE_IN)
            echo "Host '$SYS_NAME' is currently: $STATUS"; exit 0
        fi

        check_console_lock $SERIAL_DEV
        if [ ! -e "$TFTP_PATH/vmlinuz" ] || [ ! -e "$TFTP_PATH/initrd.img" ]; then
            echo "ERROR: Missing active boot images. Use: hw activate staging|production $SYS_NAME"; exit 2
        fi

        case "$COMMAND" in
            on)
                STATUS=$(check_status $LINE_IN)
                if [ "$STATUS" == "ON" ]; then echo "SUCCESS: Already running."; exit 0; fi
                if [ "$STATUS" == "UNKNOWN" ]; then echo "ERROR: Unable to read host power state."; exit 1; fi
                if ! pulse_power_line "$LINE_OUT" 1; then
                    echo "ERROR: Unable to control power GPIO line."
                    exit 1
                fi
                if wait_for_state $LINE_IN "ON" $BOOT_TIMEOUT; then
                    echo "SUCCESS: Host booted via TFTP."; exit 0
                else
                    echo "ERROR: Boot verification timed out."; exit 1
                fi
                ;;
            off)
                STATUS=$(check_status $LINE_IN)
                if [ "$STATUS" == "OFF" ]; then echo "SUCCESS: Already off."; exit 0; fi
                if [ "$STATUS" == "UNKNOWN" ]; then echo "ERROR: Unable to read host power state."; exit 1; fi
                if ! pulse_power_line "$LINE_OUT" 1; then
                    echo "ERROR: Unable to control power GPIO line."
                    exit 1
                fi
                if wait_for_state $LINE_IN "OFF" $SOFT_OFF_TIMEOUT; then
                    echo "SUCCESS: Graceful power off verified."; exit 0
                else
                    echo "WARNING: Graceful timeout reached."; exit 1
                fi
                ;;
            force-off)
                STATUS=$(check_status $LINE_IN)
                if [ "$STATUS" == "OFF" ]; then echo "SUCCESS: Already off."; exit 0; fi
                if [ "$STATUS" == "UNKNOWN" ]; then echo "ERROR: Unable to read host power state."; exit 1; fi
                if ! pulse_power_line "$LINE_OUT" 5; then
                    echo "ERROR: Unable to control power GPIO line."
                    exit 1
                fi
                if wait_for_state $LINE_IN "OFF" $HARD_OFF_TIMEOUT; then
                    echo "SUCCESS: Hard cutoff complete."; exit 0
                else
                    echo "CRITICAL ERROR: Rails remain frozen."; exit 1
                fi
                ;;
        esac
        ;;

    *)
        echo "============================================================="
        echo "HW UTILITY HELP GUIDE"
        echo "============================================================="
        echo "  hw                                    List victim deployment states"
        echo "  hw <victim>                           Direct shortcut to drop into console"
        echo "  hw user                               Lists users with lab access group permissions"
        echo "  hw user {add|del} <name>              Manages user login and TFTP isolation profiles"
        echo "  hw upload <path>                      Stages custom build modules to user root"
        echo "  hw ls [stage|prod [host]]             Lists staged or production files"
        echo "  hw cmdline {ls|cat|seed|upload|activate} ...  Manages PXE cmdline files"
        echo "  hw activate <file>                    Changes current staging boot tracking assignment"
        echo "  hw activate staging <host> [kernel initrd] Selects staged boot source for a host"
        echo "  hw activate production <host> [kernel initrd] Selects production boot source for a host"
        echo "  hw log [ls] <victim>                  Lists telemetry log sets"
        echo "  hw log cat <victim> [file]            Views target file output stream"
        echo "  hw log clean <victim> [days]          Prunes aged text logs"
        echo "  hw <victim> {status|on|off|force-off} Control <victim> power state"
        exit 2
        ;;
esac
